# Copie ce fichier en .env (dev local) et renseigne les valeurs de ton projet
# Supabase. Ces deux variables sont publiques (préfixe VITE_ = exposées au
# navigateur) — c'est normal, la clé "anon" est faite pour ça, la sécurité
# réelle vient des policies RLS dans supabase/schema.sql.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Les variables ci-dessous sont utilisées uniquement par les fonctions
# serverless dans /api (jamais exposées au client) — à définir dans les
# "Environment Variables" de Vercel, PAS dans ce fichier .env côté front.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MENSUEL=price_...
# STRIPE_PRICE_EXAMEN=price_...
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# PUBLIC_APP_URL=https://reussimaths.vercel.app
