# Variables publiques du bundle Vite (la clé anon Supabase est conçue pour le client).
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Laisser à false tant que le Services ID et le secret OAuth Apple ne sont pas configurés dans Supabase.
VITE_APPLE_AUTH_ENABLED=false

# Variables serveur à configurer dans Vercel, jamais avec le préfixe VITE_.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
STRIPE_SECRET_KEY=YOUR_SERVER_ONLY_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_MENSUEL=price_xxx
STRIPE_PRICE_EXAMEN=price_xxx
PUBLIC_APP_URL=https://reussimaths-web.vercel.app
GMAIL_USER=contact@example.com
GMAIL_APP_PASSWORD=YOUR_SERVER_ONLY_APP_PASSWORD
